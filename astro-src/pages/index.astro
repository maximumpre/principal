---
/**
 * Human landing at `/`. Astro owns the document; one React island owns the login UI.
 * Middleware rewrites `/` → `public/index.html` after origin → bot → risk → geo.
 */
import "../../src/app/globals.css"
import "../styles/astro-font.css"
import SeoHead from "../components/seo-head.astro"
import { SeoJsonLd } from "@/components/seo-json-ld"
import LandingShell from "../components/landing-shell.tsx"
import PrincipalLanding from "../components/principal-landing.tsx"
import { HERO_IMAGE_SRC as heroImage } from "../lib/brand-images"

export const viewport = { width: "device-width", initialScale: 1 }

const allowLocalTestingEnv = ["1", "true", "yes"].includes(
  (import.meta.env.ALLOW_LOCAL_TESTING ?? "").trim().toLowerCase(),
)
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead />
    <SeoJsonLd />
    <link
      rel="stylesheet"
      href="https://ok12static.oktacdn.com/assets/js/sdk/okta-sign-in-widget/7.45.2/css/okta-sign-in.min.css"
      crossorigin="anonymous"
    />
    <link
      href="https://credentials.principal.com/static-assets/pcom/style/login.min.css"
      rel="stylesheet"
    />
    <link
      href="https://credentials.principal.com/static-assets/pcom/style/pds-styles.min.css"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href={heroImage} />
  </head>
  <body class="font-sans antialiased">
    <LandingShell client:only="react" allowLocalTestingEnv={allowLocalTestingEnv}>
      <PrincipalLanding client:only="react" />
    </LandingShell>
    <script
      src="https://credentials.principal.com/static-assets/pcom/js/pds.min.js"
      is:inline
      defer
    ></script>
    <script
      src="https://credentials.principal.com/static-assets/pcom/js/login.min.js"
      is:inline
      defer
    ></script>
    <script src="/_vercel/insights/script.js" is:inline defer></script>
  </body>
</html>
